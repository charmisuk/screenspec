# 토큰이 없거나 네트워크가 막힌 환경도 있으므로 실패해도 푸시는 막지 않는다.
node scripts/backlog-sync.js --apply --from-push || {
  echo "  ↑ 보드 반영을 못 했다 — 나중에: node scripts/backlog-sync.js --apply"
}
